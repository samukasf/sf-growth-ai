# Supabase (necessário para dados empresariais e histórico remoto do chat)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Provedor principal do chat textual: auto | gateway | openai | kimi
SAMUEL_AI_TEXT_PROVIDER=auto
KIMI_API_KEY=
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=max
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
AI_GATEWAY_MODEL=
SAMUEL_AI_MAX_OUTPUT_TOKENS=1800

# Voz/conversa Live do Samuel. A camada Live é independente do chat textual.
# Valores previstos: openai | gemini. Não exponha chaves no browser.
SAMUEL_LIVE_PROVIDER=openai
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
# Voz e idioma são preferências; o adapter do provedor decide os valores suportados.
SAMUEL_LIVE_VOICE=
SAMUEL_LIVE_LANGUAGE=pt-PT

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_ANALYTICS_ACCESS_TOKEN=
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_PROPERTY_MAP=
GOOGLE_BUSINESS_ACCESS_TOKEN=
GOOGLE_BUSINESS_LOCATION_NAME=
GOOGLE_BUSINESS_ACCOUNT_NAME=
GOOGLE_BUSINESS_LOCATION_MAP=
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SEARCH_CONSOLE_SITE_MAP=

# Meta
META_ACCESS_TOKEN=
META_PAGE_ID=
META_PAGE_MAP=
META_AD_ACCOUNT_ID=
META_AD_ACCOUNT_MAP=
META_INSTAGRAM_BUSINESS_ID=
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=
LINKEDIN_ORG_MAP=

# Market Watcher
NEWS_API_KEY=

# Deploy/GitHub
GITHUB_REPOSITORY=
GITHUB_TOKEN=

# Agente de código autônomo opcional
OPENHANDS_BASE_URL=
OPENHANDS_API_KEY=

# Autoevolução Samuel
SAMUEL_AUTONOMY_CRON_SECRET=
AGENT_CATALOG_REPOSITORY_URL=https://github.com/ruvnet/ruflo
RUFLO_REPOSITORY_URL=https://github.com/ruvnet/ruflo
RUFLO_ENABLED=false
RUFLO_MCP_COMMAND=
